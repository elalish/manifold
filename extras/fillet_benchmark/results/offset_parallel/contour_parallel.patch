+#if (MANIFOLD_PAR == 1)
+TEST(CrossSection, OffsetParallelPreservesCoordinatesAndOrder) {
+  Polygons rings;
+  for (int i = 0; i < 256; ++i) {
+    const double x = (i % 16) * 12, y = (i / 16) * 12;
+    rings.push_back({{x, y}, {x + 10, y}, {x + 10, y + 10}, {x, y + 10}});
+    rings.push_back({{x + 3, y + 3}, {x + 3, y + 6},
+                     {x + 6, y + 6}, {x + 6, y + 3}});
+  }
+  const CrossSection input(rings);
+  for (const JoinType join : {JoinType::Round, JoinType::Miter,
+                             JoinType::Square, JoinType::Bevel}) {
+    for (const double delta : {0.5, 1.5, -0.5}) {
+      Polygons expected;
+      {
+        tbb::global_control serial(tbb::global_control::max_allowed_parallelism, 1);
+        const auto result = input.Offset(delta, join, 2, 32);
+        expected = result.ToPolygons();
+        if (join == JoinType::Miter && delta != 1.5) {
+          EXPECT_NEAR(result.Area(), 256 * (delta > 0 ? 117.0 : 65.0), 1e-6);
+        }
+      }
+      for (const int threads : {2, 4, 8}) {
+        tbb::global_control parallel(
+            tbb::global_control::max_allowed_parallelism, threads);
+        const auto actual = input.Offset(delta, join, 2, 32).ToPolygons();
+        ASSERT_EQ(actual.size(), expected.size());
+        for (size_t i = 0; i < actual.size(); ++i) {
+          ASSERT_EQ(actual[i].size(), expected[i].size());
+          for (size_t j = 0; j < actual[i].size(); ++j) {
+            EXPECT_EQ(actual[i][j].x, expected[i][j].x);
+            EXPECT_EQ(actual[i][j].y, expected[i][j].y);
+          }
+        }
+      }
+    }
+  }
+}
+#endif
